# Copy to .env and adjust. Loaded automatically by `flask`.
APP_ENV=development            # development | production | testing
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=sqlite:///C:/path/to/labbook.db   # default: instance/labbook.db
BASE_URL=http://127.0.0.1:5000  # used to build links in emails
DEFAULT_TIMEZONE=Asia/Kolkata

# Email: "outbox" writes .eml files to instance/outbox/; "smtp" sends for real.
MAIL_BACKEND=outbox
MAIL_FROM=LabBook <no-reply@labbook.local>
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=1

# Shared secret for cron calling POST /api/jobs/tick (header X-Jobs-Secret). Leave unset to
# disable the endpoint and run `flask jobs tick` from cron / Task Scheduler instead.
# JOBS_SECRET=

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-* headers.
TRUST_PROXY=0
